# LLM: deepseek | openrouter (sk-or-v1-) | alibaba (sk-ws- 百炼)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=48
DEEPSEEK_TIMEOUT=8

# OpenRouter — 密钥必须以 sk-or-v1- 开头
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_STT_MODEL=openai/whisper-large-v3
STT_LANGUAGE=zh

# 阿里百炼 DashScope — sk-ws- 密钥走这里，不是 OpenRouter
ALIBABA_API_KEY=
ALIBABA_MODEL=qwen-plus
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# TTS voice (edge-tts, Chinese default)
TTS_VOICE=zh-CN-XiaoxiaoNeural

MQTT_HOST=mqtt
MQTT_PORT=1883
# ASR_VENDOR=volc
# TTS_VENDOR=volc
# ASR_API_KEY=
# TTS_API_KEY=
VISION_LOCAL_URL=http://host.docker.internal:18765/v1/see
# VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# VISION_API_KEY=
# VISION_MODEL=qwen-vl-plus
